# No utilice una contraseña de ejemplo. El script scripts/Start-CompraNexus.ps1
# genera una contraseña aleatoria fuerte si este valor está vacío o no cumple
# la política de SQL Server. No publique el archivo .env en Git.
MSSQL_SA_PASSWORD=
ACCOUNTING_SERVICE_URL=
ACCOUNTING_BEARER_TOKEN=

# Solo en la PRIMERA configuración del login; elige credenciales propias.
# El administrador se crea únicamente si AppUsers está vacío; después elimina
# COMPRANEXUS_ADMIN_PASSWORD de .env para evitar guardar el secreto innecesariamente.
COMPRANEXUS_ADMIN_EMAIL=
COMPRANEXUS_ADMIN_PASSWORD=
